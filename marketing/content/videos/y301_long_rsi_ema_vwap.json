   "say": "The second tool is the simplest way to see the trend: the twenty period exponential moving average."
  },
  {
   "type": "chart",
   "chart": "ema",
   "headline": "Rising EMA, price above: uptrend",
   "reveal": [
    16,
    32
   ],
   "show": [
    "ema"
   ],
   "marks": [
    {
     "bar": 10,
     "dir": "up",
